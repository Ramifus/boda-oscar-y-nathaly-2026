---
// Portada.astro
---

<section
    id="portada-sobre"
    class="fixed inset-0 w-full h-screen z-[9999] overflow-hidden"
    style="background-image: url('/imagenes/Fondo.webp'), linear-gradient(#fffdf6, #fffdf6); background-size: cover, cover; background-position: center, center; background-repeat: no-repeat, no-repeat;"
>
    <!-- SOBRE - fondo que ocupa todo el ancho de la pantalla -->
    <img
        id="sobre-img"
        src="/imagenes/sobre.webp"
        alt="Sobre de invitación"
        fetchpriority="high"
        decoding="sync"
        class="absolute top-0 left-0 w-full h-full object-cover object-top"
        style="-webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 55%, rgba(0,0,0,0) 82%); mask-image: linear-gradient(to bottom, #000 0%, #000 55%, rgba(0,0,0,0) 82%);"
    />

    <!-- TEXTO SUPERIOR - ¡NOS CASAMOS! en dorado -->
    <div
        id="texto-superior"
        class="absolute top-[8%] left-0 right-0 text-center z-20 px-6"
    >
        <p
            class="font-cormorant uppercase tracking-[0.3em] text-2xl md:text-3xl font-semibold"
            style="color: #B8960C;"
        >
            ¡Nos Casamos!
        </p>
    </div>

    <!-- RESPLANDOR - la luz blanca que se abre desde el sello al presionarlo -->
    <div
        class="absolute inset-0 flex items-center justify-center z-30 pointer-events-none"
    >
        <div
            id="destello"
            class="w-44 h-44 md:w-52 md:h-52 rounded-full opacity-0"
            style="background: radial-gradient(circle, rgba(255,255,255,1) 0%, rgba(255,255,255,0.88) 30%, rgba(255,255,255,0) 72%);"
        >
        </div>
        <div
            id="aro"
            class="absolute w-32 h-32 md:w-36 md:h-36 rounded-full opacity-0"
            style="border: 2px solid rgba(255,255,255,0.95); box-shadow: 0 0 24px rgba(255,255,255,0.85), inset 0 0 24px rgba(255,255,255,0.55);"
        >
        </div>
    </div>

    <!-- VELO - la luz termina cubriendo la pantalla y de ahí salen los nombres.
         El blanco va como imagen, no como color: el modo oscuro forzado
         oscurece colores pero respeta las imágenes. -->
    <div
        id="velo"
        class="absolute inset-0 z-40 opacity-0 pointer-events-none"
        style="background-image: linear-gradient(#fff, #fff);"
    >
    </div>

    <!-- SELLO / BOTÓN - centrado sobre la imagen -->
    <div class="absolute inset-0 flex items-center justify-center z-20">
        <button
            id="btn-sello"
            class="cursor-pointer transition-all duration-300 hover:scale-110 active:scale-95 focus:outline-none"
        >
            <img
                id="sello-img"
                src="/imagenes/boton.png"
                alt="Sello O y N"
                width="512"
                height="541"
                fetchpriority="high"
                class="w-28 h-28 md:w-32 md:h-32"
                style="filter: drop-shadow(0 5px 16px rgba(75, 95, 55, 0.32));"
            />
        </button>
    </div>

    <!-- TEXTO - posicionado sobre la portada -->
    <div
        id="texto-portada"
        class="absolute bottom-[12%] md:bottom-[10%] left-0 right-0 text-center z-20 px-6 flex flex-col items-center"
    >
        <p
            class="font-cormorant uppercase tracking-[0.32em] text-base md:text-lg font-semibold"
            style="color: #4A6035;"
        >
            DALE CLIC AL SELLO
        </p>
        <p
            class="font-cormorant uppercase tracking-normal text-base md:text-lg font-medium mt-1"
            style="color: #4A6035;"
        >
            PARA INGRESAR A LA INVITACIÓN
        </p>
        <p
            class="font-crimson italic text-xl md:text-2xl mt-5"
            style="color: #4A6035;"
        >
            Atentamente:
        </p>
        <h2
            class="font-great-vibes text-4xl md:text-5xl mt-5 leading-tight whitespace-nowrap"
            style="color: #6B8A52;"
        >
            Oscar <span
                class="font-great-vibes"
                style="color: #5C7A42; font-size: 0.82em;"
            >y</span> Nathaly
        </h2>
    </div>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    // Bloqueo del scroll por estilo en línea (siempre gana y no depende del CSS).
    // Se hace ya, sin esperar a DOMContentLoaded, para que no se pueda desplazar
    // la página por detrás del sobre.
    function bloquearScroll(bloquear: boolean) {
        const v = bloquear ? "hidden" : "";
        document.documentElement.style.overflow = v;
        document.body.style.overflow = v;
    }
    bloquearScroll(true);

    // Las fotos no declaran alto: al terminar de cargar, la página cambia de
    // tamaño y ScrollTrigger queda con medidas viejas. Recalcular.
    window.addEventListener("load", () => ScrollTrigger.refresh());

    document.addEventListener("DOMContentLoaded", () => {
        const btnSello = document.getElementById("btn-sello");
        const portada = document.getElementById("portada-sobre");

        // Entrada del sello con efecto elástico
        gsap.from("#btn-sello", {
            scale: 0.8,
            duration: 1.5,
            ease: "elastic.out(1, 0.5)",
            delay: 0.5,
        });

        // Respiración continua del sello. Se guarda para poder cortarla al
        // hacer clic: si sigue viva, pelea con el destello por la escala.
        const respiracion = gsap.to("#btn-sello", {
            scale: 1.05,
            duration: 2.5,
            ease: "sine.inOut",
            yoyo: true,
            repeat: -1,
        });

        // Entrada suave del texto inferior
        gsap.from("#texto-portada", {
            opacity: 0,
            y: 18,
            duration: 1.2,
            ease: "power2.out",
            delay: 0.4,
        });

        // Entrada del texto superior ¡Nos Casamos!
        gsap.from("#texto-superior", {
            opacity: 0,
            y: -16,
            duration: 1.2,
            ease: "power2.out",
            delay: 0.3,
        });

        btnSello?.addEventListener("click", () => {
            // Si el reproductor está en la página se usa SU audio: dos audios
            // distintos sonarían encimados y el botón de pausa no cortaría este.
            const delReproductor = document.getElementById("music-audio");
            const audio =
                delReproductor instanceof HTMLAudioElement
                    ? delReproductor
                    : new Audio("/musica/melodia.mp3");
            audio.loop = true;
            audio.volume = 0.5;
            audio.play().catch((error: any) => {
                console.log("Error al reproducir audio:", error);
            });

            (window as any).audioGlobal = audio;
            (window as any).estaReproduciendoGlobal = true;

            // El botón flotante pinta sus iconos escuchando al audio, así que
            // no hace falta avisarle desde acá.

            // Liberar el scroll YA. Antes se liberaba, pero el sobre seguía
            // encima 0.8s capturando el toque: el primer deslizamiento no
            // hacía nada y había que repetirlo.
            if (portada) portada.style.pointerEvents = "none";
            bloquearScroll(false);
            window.scrollTo(0, 0);

            // Resplandor blanco del sello, la luz cubre la pantalla y recién
            // ahí se van el sobre y el velo dejando ver los nombres.
            respiracion.kill();

            const salida = gsap.timeline();

            salida
                .to("#btn-sello", {
                    scale: 0.9,
                    duration: 0.14,
                    ease: "power2.in",
                })
                .to("#btn-sello", {
                    scale: 1.2,
                    duration: 0.7,
                    ease: "power2.out",
                })
                // El sello se enciende en blanco
                .to(
                    "#sello-img",
                    {
                        filter: "drop-shadow(0 0 30px rgba(255, 255, 255, 0.95)) brightness(1.6)",
                        duration: 0.3,
                        ease: "power2.out",
                    },
                    "-=0.7",
                )
                // Aro de luz que se abre desde el sello
                .fromTo(
                    "#aro",
                    { scale: 0.5, opacity: 0 },
                    {
                        scale: 2.8,
                        opacity: 0.85,
                        duration: 0.5,
                        ease: "power2.out",
                    },
                    "-=0.7",
                )
                .to(
                    "#aro",
                    { scale: 4.2, opacity: 0, duration: 0.5, ease: "power1.in" },
                    "-=0.2",
                )
                // Resplandor que crece hasta inundar la pantalla
                .fromTo(
                    "#destello",
                    { scale: 0.4, opacity: 0 },
                    {
                        scale: 3.2,
                        opacity: 1,
                        duration: 0.65,
                        ease: "power2.out",
                    },
                    "-=0.85",
                )
                .to(
                    "#velo",
                    { opacity: 1, duration: 0.45, ease: "power2.inOut" },
                    "-=0.3",
                )
                // La luz se va y detrás quedan los nombres animándose
                .to(
                    portada,
                    {
                        opacity: 0,
                        duration: 0.9,
                        ease: "power2.out",
                        onStart: () => {
                            // Le da la orden a NombresFlores: su animación
                            // esperaba esta señal para no correr a espaldas
                            // del sobre.
                            window.dispatchEvent(new Event("portada-abierta"));
                        },
                        onComplete: () => {
                            portada?.remove();
                            ScrollTrigger.refresh();
                        },
                    },
                    "-=0.05",
                );
        });
    });
</script>
