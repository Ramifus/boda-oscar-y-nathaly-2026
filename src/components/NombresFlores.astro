<section class="relative text-black w-full ">

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- 🌸 SECCIÓN 1: FLORES SUPERIORES + TÍTULO + ANILLOS         -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <div class="relative w-full overflow-visible" id="flores-superiores">
        
        <!-- 🌸 Contenedor de flores superiores (izquierda y derecha) -->
        <div class="relative w-full flex justify-between items-start">
            <!-- Flores izquierda superior -->
            <div id="flores-sup-izq" class="w-32 sm:w-36 md:w-40 lg:w-36 flex-shrink-0">
                <img
                    src="/imagenes/florarriba.png"
                    alt="Flores superiores izquierda"
                    class="w-full h-auto object-contain"
                    style="opacity: 1 !important;"
                />
            </div>

            <!-- Flores derecha superior (misma imagen que la izquierda, en espejo) -->
            <div id="flores-sup-der" class="w-32 sm:w-36 md:w-40 lg:w-36 flex-shrink-0">
                <img
                    src="/imagenes/florarriba.png"
                    alt="Flores superiores derecha"
                    class="w-full h-auto object-contain transform -scale-x-100"
                    style="opacity: 1 !important;"
                />
            </div>
        </div>

        <!-- 💍 Título "Nos Casamos" (posición absoluta, centrado) -->
        <div
            class="absolute pt-2 left-1/2 transform -translate-x-1/2 top-[40px] sm:top-[45px] md:top-[55px] lg:top-[65px] z-50"
            id="titulo-container"
        >
            <h1
                class="font-charm text-2xl sm:text-3xl md:text-4xl lg:text-5xl text-[#9d8048] font-normal tracking-wide whitespace-nowrap text-center"
                id="titulo"
            >
                Nuestra Boda
            </h1>
        </div>

        <!-- 💎 Anillos (posición absoluta, debajo del título) -->
        <div
            class="absolute left-1/2 transform -translate-x-1/2 top-[120px] sm:top-[130px] md:top-[190px] lg:top-[190px] z-50"
            id="anillos"
        >
            <!-- Anillos -->
            <div class="relative w-[120px] sm:w-32 md:w-36 lg:w-40 mx-auto">
                <img
                    id="anillo-img-top"
                    src="/imagenes/anillos.png"
                    alt="Anillos de boda"
                    class="w-full h-auto object-contain block"
                />
            </div>
        </div>
    </div>


    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- 💑 SECCIÓN 2: NOMBRES DE LOS NOVIOS                         -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <div class="relative w-full pt-20 sm:pt-24 md:pt-40 lg:pt-48">

        <!-- ✨ SEPARADOR ORNAMENTAL SVG (entre los anillos y los nombres) -->
        <div class="flex justify-center mb-8 md:mb-12 px-6" id="separador-anillos">
            <svg
                viewBox="0 0 600 28"
                role="img"
                aria-label="Separador decorativo"
                class="w-64 sm:w-80 md:w-96 lg:w-[30rem] h-auto text-[#9d8048]"
            >
                <defs>
                    <linearGradient id="swashIzq" x1="0" y1="0" x2="1" y2="0">
                        <stop offset="0" stop-color="currentColor" stop-opacity="0" />
                        <stop offset="0.5" stop-color="currentColor" stop-opacity="0.75" />
                        <stop offset="1" stop-color="currentColor" stop-opacity="1" />
                    </linearGradient>
                    <linearGradient id="swashDer" x1="0" y1="0" x2="1" y2="0">
                        <stop offset="0" stop-color="currentColor" stop-opacity="1" />
                        <stop offset="0.5" stop-color="currentColor" stop-opacity="0.75" />
                        <stop offset="1" stop-color="currentColor" stop-opacity="0" />
                    </linearGradient>
                </defs>

                <!-- Trazos caligráficos: nacen en punta y engrosan hacia el centro -->
                <path d="M18 14 C 110 12.8, 210 12.2, 268 12.5 L 268 15.5 C 210 15.8, 110 15.2, 18 14 Z"
                      fill="url(#swashIzq)" />
                <path d="M582 14 C 490 12.8, 390 12.2, 332 12.5 L 332 15.5 C 390 15.8, 490 15.2, 582 14 Z"
                      fill="url(#swashDer)" />

                <!-- Gotas de transición -->
                <circle cx="278" cy="14" r="1.4" fill="currentColor" fill-opacity="0.75" />
                <circle cx="322" cy="14" r="1.4" fill="currentColor" fill-opacity="0.75" />

                <!-- Rombo central -->
                <path d="M300 5 L 307 14 L 300 23 L 293 14 Z"
                      fill="none" stroke="currentColor" stroke-width="1" stroke-linejoin="round" />
                <circle cx="300" cy="14" r="1.9" fill="currentColor" />
            </svg>
        </div>

        <div class="relative flex justify-center w-full">

            <!-- 🌺 FLORES DORADAS IZQUIERDA (posición absoluta, lado izquierdo) -->
            <div id="flores-doradas-izq" class="absolute left-0 top-1/2 transform -translate-y-1/2 flex-shrink-0 z-20">
                <img
                    src="/imagenes/FloresDoradasIzquierda.webp"
                    alt="Flores doradas izquierda"
                    class="w-12 h-auto sm:w-20 md:w-24 lg:w-44 object-contain"
                />
            </div>

            <!-- 🌺 FLORES DORADAS DERECHA (posición absoluta, lado derecho) -->
            <div id="flores-doradas-der" class="absolute right-0 top-1/2 transform -translate-y-1/2 flex-shrink-0 z-20">
                <img
                    src="/imagenes/FloresDoradasDerecha.webp"
                    alt="Flores doradas derecha"
                    class="w-12 h-auto sm:w-20 md:w-24 lg:w-44 object-contain"
                />
            </div>

            <!-- 📝 Contenedor centrado de nombres -->
            <div class="text-center z-10 max-w-4xl w-full">

                <div class="relative mb-8 w-full" id="nombres-container">
                    <div class="relative z-30">
                        
                        <!-- 👨 Nombre del novio -->
                        <h2
                            class="font-great-vibes text-6xl sm:text-7xl md:text-8xl lg:text-9xl text-[#535636] tracking-wide mb-2"
                            id="nombre-novio"
                        ></h2>

                        <!-- ⚭ Símbolo & -->
                        <div class="text-[#9d8048] text-5xl sm:text-6xl md:text-7xl font-charm my-4" id="ampersand">
                            &
                        </div>

                        <!-- 👰 Nombre de la novia -->
                        <h2
                            class="font-great-vibes text-6xl sm:text-7xl md:text-8xl lg:text-9xl text-[#535636] tracking-wide mt-2"
                            id="nombre-novia"
                        ></h2>
                    </div>
                </div>

            </div>

        </div>


        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- ✨ SECCIÓN 3: SEPARADOR CON BRILLOS LATERALES               -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <div class="relative w-full overflow-visible flex items-center justify-between -mt-6 sm:-mt-8 md:-mt-10 lg:-mt-12" id="separador-container">

            <!-- ✨ Brillo IZQUIERDA -->
            <div id="flores-izq" class="flex-shrink-0 z-0 lg:absolute lg:left-0">
                <img
                    src="/imagenes/BrilloIzquierda.webp"
                    alt="Flores izquierda"
                    class="w-10 h-auto sm:w-24 md:w-32 lg:w-40 object-contain"
                />
            </div>

            <!-- ═══ SEPARADOR (centro) ═══ -->
            <div class="flex-grow mx-4 sm:mx-6 md:mx-8" id="separador-inferior">
                <img
                    src="/imagenes/separador.png"
                    alt="Separador decorativo"
                    class="w-[144px] sm:w-48 md:w-48 lg:w-56 h-auto object-contain block mx-auto"
                />
            </div>

            <!-- ✨ Brillo DERECHA -->
            <div id="flores-der" class="flex-shrink-0 z-0 lg:absolute lg:right-0">
                <img
                    src="/imagenes/BrilloDerecha.webp"
                    alt="Flores derecha"
                    class="w-10 h-auto sm:w-24 md:w-32 lg:w-40 object-contain"
                />
            </div>

        </div>

    </div>

</section>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎬 ANIMACIONES CON GSAP                                     -->
<!-- ═══════════════════════════════════════════════════════════ -->
<script>
    import { gsap } from "gsap";

    document.addEventListener("DOMContentLoaded", () => {
        console.log("🎊 Iniciando animaciones de boda - TODAS AL MISMO TIEMPO...");

        // ═══ FLORES SUPERIORES ═══
        gsap.fromTo(
            "#flores-sup-izq",
            { opacity: 0, x: -50 },
            { opacity: 1, x: 0, duration: 1.1, ease: "power2.out", delay: 0 }
        );

        gsap.fromTo(
            "#flores-sup-der",
            { opacity: 0, x: 50 },
            { opacity: 1, x: 0, duration: 1.1, ease: "power2.out", delay: 0 }
        );

        // ═══ TÍTULO "NOS CASAMOS" ═══
        gsap.fromTo(
            "#titulo",
            { opacity: 0, y: -28 },
            { opacity: 1, y: 0, duration: 1.1, ease: "power2.out", delay: 0.1 }
        );

        // ═══ SEPARADOR ORNAMENTAL ═══
        gsap.fromTo(
            "#separador-anillos",
            { opacity: 0, scaleX: 0.7 },
            { opacity: 1, scaleX: 1, duration: 1.2, ease: "power2.out", delay: 0.45 }
        );

        // ═══ ANILLOS ═══
        gsap.fromTo(
            "#anillos",
            { opacity: 0, scale: 0.9 },
            { opacity: 1, scale: 1, duration: 1.1, ease: "power2.out", delay: 0.2 }
        );

        // Rotación suave continua de los anillos
        gsap.to("#anillo-img-top", {
            rotation: 5,
            duration: 3,
            ease: "sine.inOut",
            yoyo: true,
            repeat: -1,
            delay: 1
        });

        // ═══ FUNCIÓN PARA ANIMAR NOMBRES LETRA POR LETRA ═══
        function animarNombre(elementId, texto, delay = 0) {
            const contenedor = document.getElementById(elementId);
            if (!contenedor) return;

            contenedor.innerHTML = texto
                .split("")
                .map(
                    (letra, index) =>
                        `<span class="letra-cascada" style="
                            --i: ${index};
                            opacity: 0; 
                            display: inline-block; 
                            transform: translateY(20px) scale(0.8);
                            filter: blur(2px);
                        ">${letra === " " ? "&nbsp;" : letra}</span>`
                )
                .join("");

            gsap.to(`#${elementId} .letra-cascada`, {
                opacity: 1,
                y: 0,
                scale: 1,
                filter: "blur(0px)",
                duration: 1.1,
                ease: "power2.out",
                stagger: { each: 0.055, from: "start" },
                delay: delay
            });
        }

        // ═══ NOMBRE DEL NOVIO ═══
        animarNombre("nombre-novio", "Oscar", 0.3);

        // ═══ SÍMBOLO & ═══
        gsap.fromTo(
            "#ampersand",
            { opacity: 0, scale: 0.92 },
            { opacity: 1, scale: 1, duration: 0.85, ease: "power2.out", delay: 0.5 }
        );

        // ═══ NOMBRE DE LA NOVIA ═══
        animarNombre("nombre-novia", "Nathaly", 0.6);

        // ═══ FLORES DORADAS ═══
        gsap.fromTo(
            "#flores-doradas-izq",
            { opacity: 0, x: -50 },
            { opacity: 1, x: 0, duration: 1.1, ease: "power2.out", delay: 0.4 }
        );

        gsap.fromTo(
            "#flores-doradas-der",
            { opacity: 0, x: 50 },
            { opacity: 1, x: 0, duration: 1.1, ease: "power2.out", delay: 0.4 }
        );

        // ═══ BRILLOS LATERALES ═══
        gsap.fromTo(
            "#flores-izq",
            { opacity: 0, x: -50, scale: 0.96 },
            { opacity: 1, x: 0, scale: 1, duration: 1.1, ease: "power2.out", delay: 0.7 }
        );

        gsap.fromTo(
            "#flores-der",
            { opacity: 0, x: 50, scale: 0.96 },
            { opacity: 1, x: 0, scale: 1, duration: 1.1, ease: "power2.out", delay: 0.7 }
        );

        // ═══ SEPARADOR (misma animación que anillos) ═══
        gsap.fromTo(
            "#separador-inferior",
            { opacity: 0, scale: 0.9 },
            { opacity: 1, scale: 1, duration: 1.1, ease: "power2.out", delay: 0.8 }
        );

        // ═══ EFECTO PULSANTE EN BRILLOS ═══
        gsap.to("#flores-izq", {
            opacity: 0.8,
            scale: 1.05,
            duration: 2,
            ease: "sine.inOut",
            yoyo: true,
            repeat: -1,
            delay: 2
        });

        gsap.to("#flores-der", {
            opacity: 0.8,
            scale: 1.05,
            duration: 2,
            ease: "sine.inOut",
            yoyo: true,
            repeat: -1,
            delay: 2
        });

        console.log("✨ Animaciones de boda completadas en ~1.5 segundos!");
    });
</script>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎨 ESTILOS CSS                                              -->
<!-- ═══════════════════════════════════════════════════════════ -->
<style>
    /* Forzar opacidad completa en flores */
    #flores-superiores img,
    #separador-inferior,
    #separador-inferior img {
        opacity: 1 !important;
    }

    /* Efecto hover en letras */
    .letra-cascada {
        transition: all 0.3s ease;
        will-change: transform, opacity, filter;
        position: relative;
    }

    .letra-cascada:hover {
        transform: translateY(-3px) scale(1.08) !important;
        text-shadow: 0 0 15px rgba(157, 128, 72, 0.4) !important;
    }

    /* Eliminar padding en móviles */
    @media (max-width: 640px) {
        section {
            padding-left: 0 !important;
            padding-right: 0 !important;
        }
    }


</style>