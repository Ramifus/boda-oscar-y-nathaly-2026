---
// Pase.astro
// Muestra el número de pases asignados a cada invitado.
// Se configura desde el index: <Pase numeroPases={2} nombreInvitado="Familia García" />

interface Props {
    numeroPases?: number; // 1, 2, 3, etc.
    nombreInvitado?: string; // Opcional: "Juan Pérez", "Familia García", etc.
}

const { numeroPases = 1, nombreInvitado = "" } = Astro.props;
---

<section class="py-8 md:py-10 px-4 relative">
    <div class="max-w-2xl mx-auto relative" id="contenedor-pases">

        <!-- 🌸 FLORES EN EL BORDE IZQUIERDO -->
        <div
            class="absolute left-0 top-1/2 -translate-y-1/2 w-24 sm:w-28 md:w-32 lg:w-36 pointer-events-none z-20 -ml-10 sm:-ml-14 md:-ml-16"
            id="flores-pase-izq"
        >
            <img
                src="/imagenes/laterales.png"
                alt="Flores decorativas izquierda"
                class="w-full h-auto object-contain"
            />
        </div>

        <!-- 🌸 FLORES EN EL BORDE DERECHO -->
        <div
            class="absolute right-0 top-1/2 -translate-y-1/2 w-24 sm:w-28 md:w-32 lg:w-36 pointer-events-none z-20 -mr-10 sm:-mr-14 md:-mr-16"
            id="flores-pase-der"
        >
            <img
                src="/imagenes/laterales.png"
                alt="Flores decorativas derecha"
                class="w-full h-auto object-contain scale-x-[-1]"
            />
        </div>

        <!-- 💠 CUADRO CON EFECTO BLUR -->
        <div
            class="relative backdrop-blur-md bg-white/40 rounded-[2rem] border border-[#9d8048]/30 shadow-lg px-8 py-10 md:px-12 md:py-12 overflow-hidden"
            id="card-pase"
        >
            <!-- Brillo superior sutil -->
            <div class="absolute top-0 left-0 right-0 h-1/2 bg-gradient-to-b from-white/40 to-transparent pointer-events-none"></div>

            <!-- Ornamentos dorados en las esquinas -->
            <div class="absolute top-4 left-4 w-12 h-12 border-t border-l border-[#9d8048]/50 rounded-tl-2xl pointer-events-none"></div>
            <div class="absolute top-4 right-4 w-12 h-12 border-t border-r border-[#9d8048]/50 rounded-tr-2xl pointer-events-none"></div>
            <div class="absolute bottom-4 left-4 w-12 h-12 border-b border-l border-[#9d8048]/50 rounded-bl-2xl pointer-events-none"></div>
            <div class="absolute bottom-4 right-4 w-12 h-12 border-b border-r border-[#9d8048]/50 rounded-br-2xl pointer-events-none"></div>

            <div class="relative z-10 text-center">

                <!-- 🎟️ ICONO DE PASE -->
                <div class="flex justify-center mb-5" id="icono-pase">
                    <div
                        role="img"
                        aria-label="Pase de invitación"
                        class="w-16 h-16 md:w-20 md:h-20 bg-[#9d8048]"
                        style="-webkit-mask: url('/imagenes/pass.png') center / contain no-repeat; mask: url('/imagenes/pass.png') center / contain no-repeat;"
                    ></div>
                </div>

                <!-- TÍTULO -->
                <h3
                    class="font-charm text-xl md:text-2xl text-[#9d8048] mb-4"
                    id="titulo-pase"
                >
                    Pases Asignados
                </h3>

                <!-- ✨ LÍNEA DECORATIVA -->
                <div class="flex items-center justify-center gap-3 mb-6" id="linea-pase">
                    <div class="w-14 md:w-20 h-px bg-gradient-to-r from-transparent to-[#9d8048]/70"></div>
                    <div class="w-2 h-2 bg-[#9d8048] rotate-45"></div>
                    <div class="w-14 md:w-20 h-px bg-gradient-to-l from-transparent to-[#9d8048]/70"></div>
                </div>

                <!-- NOMBRE DEL INVITADO (opcional) -->
                {
                    nombreInvitado && (
                        <p
                            class="font-great-vibes text-3xl md:text-4xl text-[#535636] leading-tight mb-6"
                            id="nombre-pase"
                        >
                            {nombreInvitado}
                        </p>
                    )
                }

                <!-- 🔢 NÚMERO DE PASES -->
                <div class="mb-6" id="numero-pase">
                    <p class="font-crimson text-6xl md:text-7xl text-[#9d8048] font-semibold leading-none mb-2">
                        {numeroPases}
                    </p>
                    <p class="font-charm text-lg md:text-xl tracking-[0.22em] text-[#535636]">
                        {numeroPases === 1 ? "Pase" : "Pases"}
                    </p>
                </div>

                <!-- 👤 ICONOS DE PERSONAS -->
                <div class="flex justify-center flex-wrap gap-3 mb-6" id="personas-pase">
                    {
                        Array.from({ length: numeroPases }).map(() => (
                            <div class="w-9 h-9 rounded-full border border-[#9d8048]/40 bg-[#9d8048]/10 flex items-center justify-center persona-pase">
                                <svg
                                    class="w-5 h-5 text-[#9d8048]"
                                    fill="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                                </svg>
                            </div>
                        ))
                    }
                </div>

                <!-- TEXTO DESCRIPTIVO -->
                <p
                    class="font-charm text-xl md:text-2xl text-[#535636] leading-relaxed px-2 md:px-4"
                    id="texto-pase"
                >
                    {
                        numeroPases === 1
                            ? "Esperamos contar con tu presencia"
                            : "Esperamos contar con su presencia"
                    }
                </p>

            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎬 ANIMACIONES CON GSAP                                     -->
<!-- ═══════════════════════════════════════════════════════════ -->
<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    if (typeof window !== "undefined") {
        document.addEventListener("DOMContentLoaded", () => {
            // 🎯 ESTADO INICIAL - Todo oculto
            gsap.set("#card-pase", { opacity: 0, y: 22, scale: 0.96 });
            gsap.set("#flores-pase-izq", { opacity: 0, x: -22 });
            gsap.set("#flores-pase-der", { opacity: 0, x: 22 });
            gsap.set("#icono-pase", { opacity: 0, scale: 0.92 });
            gsap.set("#titulo-pase", { opacity: 0, y: 15 });
            gsap.set("#linea-pase", { opacity: 0, scaleX: 0.7 });
            gsap.set("#nombre-pase", { opacity: 0, y: 15 });
            gsap.set("#numero-pase", { opacity: 0, scale: 0.92 });
            gsap.set(".persona-pase", { opacity: 0, scale: 0.85 });
            gsap.set("#texto-pase", { opacity: 0, y: 15 });

            ScrollTrigger.create({
                trigger: "#card-pase",
                start: "top 90%",
                end: "top 20%",
                onEnter: () => animarEntrada(),
                onLeaveBack: () => animarSalida(),
            });

            // ✨ ENTRADA ESCALONADA - cada elemento entra por separado
            function animarEntrada() {
                const tl = gsap.timeline();

                tl.to("#card-pase", {
                    opacity: 1,
                    y: 0,
                    scale: 1,
                    duration: 1.4,
                    ease: "power2.out",
                })
                    .to(
                        "#flores-pase-izq, #flores-pase-der",
                        {
                            opacity: 1,
                            x: 0,
                            duration: 1.4,
                            ease: "power2.out",
                            stagger: 0.12,
                        },
                        "<0.1"
                    )
                    .to(
                        "#icono-pase",
                        { opacity: 1, scale: 1, duration: 1.2, ease: "power2.out" },
                        "<0.12"
                    )
                    .to(
                        "#titulo-pase",
                        { opacity: 1, y: 0, duration: 1.2, ease: "power2.out" },
                        "<0.12"
                    )
                    .to(
                        "#linea-pase",
                        { opacity: 1, scaleX: 1, duration: 1, ease: "power2.out" },
                        "<0.12"
                    )
                    .to(
                        "#nombre-pase",
                        { opacity: 1, y: 0, duration: 1.2, ease: "power2.out" },
                        "<0.12"
                    )
                    .to(
                        "#numero-pase",
                        { opacity: 1, scale: 1, duration: 1.2, ease: "power2.out" },
                        "<0.12"
                    )
                    .to(
                        ".persona-pase",
                        {
                            opacity: 1,
                            scale: 1,
                            duration: 0.9,
                            ease: "power2.out",
                            stagger: 0.14,
                        },
                        "<0.12"
                    )
                    .to(
                        "#texto-pase",
                        { opacity: 1, y: 0, duration: 1.4, ease: "power2.out" },
                        "<0.12"
                    );
            }

            // 👋 SALIDA
            function animarSalida() {
                gsap.to(
                    "#card-pase, #flores-pase-izq, #flores-pase-der, #icono-pase, #titulo-pase, #linea-pase, #nombre-pase, #numero-pase, .persona-pase, #texto-pase",
                    {
                        opacity: 0,
                        duration: 0.7,
                        ease: "power2.in",
                    }
                );
            }
        });
    }
</script>
