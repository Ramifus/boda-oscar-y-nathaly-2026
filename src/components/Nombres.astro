<!-- 👨‍👩‍👧 COMPONENTE NOMBRES - PADRES Y PADRINOS DE BODA        -->
<!-- ═══════════════════════════════════════════════════════════ -->

<section class="relative py-2">
  <div class="max-w-5xl mx-auto relative">
    
    <!-- 🌸 Adorno floral izquierdo - CENTRADO VERTICALMENTE -->
    <div class="absolute left-0 top-1/2 -translate-y-1/2 w-16 pointer-events-none -ml-6 sm:-ml-7 md:-ml-8" id="adorno-izq">
      <img 
        src="/imagenes/Hojas.webp" 
        alt="Adorno floral izquierdo" 
        class="w-full h-auto object-contain transform -scale-x-100" 
      />
    </div>

    <!-- 📝 Contenido central -->
    <div class="max-w-3xl mx-auto text-center relative z-10 px-4 md:px-8 lg:px-12">
      
      <!-- 🌸 SEPARADOR FLORAL SUPERIOR -->
      <div class="flex justify-center mb-8 md:mb-10" id="separador-bendicion">
        <img
          src="/imagenes/separador.png"
          alt="Separador decorativo"
          class="w-36 sm:w-44 md:w-52 h-auto object-contain"
        />
      </div>

      <!-- ✨ TEXTO DE BENDICIÓN -->
      <div id="texto-bendicion" class="mb-8 px-0">
        <p class="font-charm text-2xl sm:text-2xl md:text-3xl text-[#9d8048] leading-relaxed">
          Con la bendición de Dios, de nuestros queridos padres y amados padrinos
        </p>
      </div>
      
      <!-- 👔 SECCIÓN 1: PADRES DEL NOVIO -->
      <div id="seccion-padres-novio" class="max-w-xl mx-auto">
        <h2 class="font-charm text-xl sm:text-2xl text-[#9d8048] font-bold mb-2">
          Padres del novio
        </h2>
        <div class="space-y-1">
          <p class="font-charm text-xl sm:text-xl text-[#535636]">Edgar M. Rojas Arias</p>
          <p class="font-charm text-xl sm:text-xl text-[#535636]">Jhenny J. Zamorano Valdivia</p>
        </div>
      </div>

      <!-- 👗 SECCIÓN 2: PADRES DE LA NOVIA -->
      <div id="seccion-padres-novia" class="pt-6 max-w-xl mx-auto">
        <h2 class="font-charm text-xl sm:text-2xl text-[#9d8048] font-bold mb-2">
          Padres de la novia
        </h2>
        <div class="space-y-1">
          <p class="font-charm text-xl sm:text-xl text-[#535636]">Cesar G. Aliaga Auza (†)</p>
          <p class="font-charm text-xl sm:text-xl text-[#535636]">Guadalupe Apaza Condori</p>
        </div>
      </div>

      <!-- 💍 SECCIÓN 3: PADRINOS -->
      <div id="seccion-padrinos-religiosos" class="pt-6 max-w-xl mx-auto">
        <h2 class="font-charm text-xl sm:text-2xl text-[#9d8048] font-bold mb-2">
          Padrinos
        </h2>
        <div class="space-y-1">
          <p class="font-charm text-xl sm:text-xl text-[#535636]">Edwin Zamorano Valdivia</p>
          <p class="font-charm text-xl sm:text-xl text-[#535636]">Ingrid Vera Carvajal</p>
        </div>
      </div>

      <!-- 📜 SECCIÓN 4: PADRINOS DE ARO -->
      <div id="seccion-padrinos-civiles" class="pt-6 max-w-xl mx-auto">
        <h2 class="font-charm text-xl sm:text-2xl text-[#9d8048] font-bold mb-2">
          Padrinos de Aro
        </h2>
        <div class="space-y-1">
          <p class="font-charm text-xl sm:text-xl text-[#535636]">E. Jorge Rojas Zamorano</p>
          <p class="font-charm text-xl sm:text-xl text-[#535636]">Katherine M. Vaca Ponce</p>
