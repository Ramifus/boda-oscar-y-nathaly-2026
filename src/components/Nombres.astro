    </div>

    <!-- 🌸 Adorno floral derecho - CENTRADO VERTICALMENTE -->
    <div class="absolute right-0 top-1/2 -translate-y-1/2 w-16 pointer-events-none -mr-6 sm:-mr-7 md:-mr-8" id="adorno-der">
      <img 
        src="/imagenes/Hojas.webp" 
        alt="Adorno floral derecho" 
        class="w-full h-auto object-contain" 
      />
    </div>
    
  </div>
</section>

