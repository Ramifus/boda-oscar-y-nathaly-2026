---
// SugerenciaRegalo.astro
---

<section class="py-8 md:py-12 lg:py-16 px-4 relative overflow-hidden">
  <!-- Fondo sutil con textura -->
  <div
    class="absolute inset-0 bg-gradient-to-b from-[#f5f9f0]/40 via-[#faf8f5]/20 to-[#f5f9f0]/40 z-0"
  >
  </div>

  <div class="max-w-4xl mx-auto relative z-10">
    <!-- CONTENEDOR PRINCIPAL CON HOJAS -->
    <div class="relative">
      <!-- 🍃 HOJA LATERAL IZQUIERDA -->
      <div
        class="absolute -left-8 md:-left-16 top-1/2 -translate-y-1/2 w-20 md:w-28 pointer-events-none z-0"
        id="hoja-qr-izq"
      >
        <img
          src="/imagenes/Hojas.webp"
          alt="Hoja decorativa"
          class="w-full h-auto object-contain transform -scale-x-100 opacity-60"
        />
      </div>

      <!-- 🍃 HOJA LATERAL DERECHA -->
      <div
        class="absolute -right-8 md:-right-16 top-1/2 -translate-y-1/2 w-20 md:w-28 pointer-events-none z-0"
        id="hoja-qr-der"
      >
        <img
          src="/imagenes/Hojas.webp"
          alt="Hoja decorativa"
          class="w-full h-auto object-contain opacity-60"
        />
      </div>

      <!-- TÍTULO -->
      <div class="text-center mb-6" id="titulo-qr">
        <h2
          class="font-charm text-2xl md:text-4xl lg:text-5xl text-[#9d8048] font-bold mb-4"
        >
          SUGERENCIA DE REGALOS
        </h2>
        <!-- Línea decorativa -->
        <div class="flex items-center justify-center gap-3">
          <div
            class="w-16 h-[2px] bg-gradient-to-r from-transparent to-[#9d8048]"
          >
          </div>
          <div class="w-2 h-2 rounded-full bg-[#9d8048]"></div>
          <div
            class="w-16 h-[2px] bg-gradient-to-l from-transparent to-[#9d8048]"
          >
          </div>
        </div>
      </div>

      <!-- 🎁 ICONO REGALO CON FLORES EN LOS BORDES -->
      <div class="relative mb-6" id="icono-regalo">

        <!-- 🌸 FLORES EN EL BORDE IZQUIERDO (PEGADA AL BORDE DEL CONTENEDOR) -->
        <div class="absolute left-0 top-1/2 -translate-y-1/2 w-24 sm:w-28 md:w-32 lg:w-36 pointer-events-none -ml-10 sm:-ml-14 md:-ml-16" id="flores-qr-izq">
          <img
            src="/imagenes/laterales.png"
            alt="Flores decorativas izquierda"
            class="w-full h-auto object-contain"
          />
        </div>

        <!-- ICONO CENTRAL -->
        <div class="flex justify-center">
          <div
            role="img"
            aria-label="Regalo"
            class="w-20 h-20 md:w-24 md:h-24 lg:w-28 lg:h-28 drop-shadow-md icono-regalo-dorado"
            style="-webkit-mask-image: url('/imagenes/regalo.png'); mask-image: url('/imagenes/regalo.png');"
          >
          </div>
        </div>

        <!-- 🌸 FLORES EN EL BORDE DERECHO (PEGADA AL BORDE DEL CONTENEDOR) -->
        <div class="absolute right-0 top-1/2 -translate-y-1/2 w-24 sm:w-28 md:w-32 lg:w-36 pointer-events-none -mr-10 sm:-mr-14 md:-mr-16" id="flores-qr-der">
          <img
            src="/imagenes/laterales.png"
            alt="Flores decorativas derecha"
            class="w-full h-auto object-contain scale-x-[-1]"
          />
        </div>

      </div>

      <!-- MENSAJE PRINCIPAL -->
      <div class="max-w-2xl mx-auto mb-10 px-6 sm:px-8 md:px-10" id="mensaje-qr">
        <p
          class="font-charm text-xl text-[#535636] text-center leading-relaxed"
        >
         Con mucha alegría queremos compartir con ustedes este momento tan especial.
Su presencia será nuestro mejor regalo. <br />

Y si desean hacernos un obsequio y no saben qué regalarnos, pueden hacerlo mediante QR, ayudándonos a cumplir nuestros sueños en esta nueva etapa juntos.
<br/>
<span class="text-[#9d8048] font-bold">¡Gracias por ser parte de nuestro día especial!</span>
        </p>
      </div>

      <!-- 💠 CARD CON QR Y DATOS (mismo estilo con blur) -->
      <div
        class="relative backdrop-blur-md bg-white/40 rounded-[2rem] border border-[#9d8048]/30 shadow-lg px-8 py-10 md:px-12 md:py-12 max-w-xl mx-auto overflow-hidden"
        id="card-qr"
      >
        <!-- Brillo superior sutil -->
        <div class="absolute top-0 left-0 right-0 h-1/2 bg-gradient-to-b from-white/40 to-transparent pointer-events-none"></div>

        <!-- Ornamentos dorados en las esquinas -->
        <div class="absolute top-4 left-4 w-12 h-12 border-t border-l border-[#9d8048]/50 rounded-tl-2xl pointer-events-none"></div>
        <div class="absolute top-4 right-4 w-12 h-12 border-t border-r border-[#9d8048]/50 rounded-tr-2xl pointer-events-none"></div>
        <div class="absolute bottom-4 left-4 w-12 h-12 border-b border-l border-[#9d8048]/50 rounded-bl-2xl pointer-events-none"></div>
        <div class="absolute bottom-4 right-4 w-12 h-12 border-b border-r border-[#9d8048]/50 rounded-br-2xl pointer-events-none"></div>

        <div class="relative z-10 flex flex-col items-center justify-center" id="qr-container">
          <!-- QR GRANDE - pensado para escanear desde el celular -->
          <div
            class="w-72 h-72 sm:w-80 sm:h-80 md:w-96 md:h-96 bg-white rounded-2xl border-2 border-[#9d8048]/20 flex items-center justify-center shadow-sm mb-5"
          >
            <img
              src="/imagenes/qr.png"
              alt="Código QR para regalo"
              class="w-full h-full object-contain p-3"
            />
          </div>
          <p class="font-charm text-lg md:text-xl text-[#9d8048] font-bold">
            Escanea el código
          </p>
        </div>

        <!-- 💳 DATOS DE LA CUENTA -->
        <div class="relative z-10 mt-8" id="datos-qr">

          <!-- Separador fino dorado -->
          <div class="flex items-center justify-center gap-3 mb-7">
            <div class="w-14 md:w-20 h-px bg-gradient-to-r from-transparent to-[#9d8048]/70"></div>
            <div class="w-1.5 h-1.5 rounded-full bg-[#9d8048]"></div>
            <div class="w-14 md:w-20 h-px bg-gradient-to-l from-transparent to-[#9d8048]/70"></div>
          </div>

          <!-- Nº DE CUENTA -->
          <div class="text-center mb-6">
            <p class="font-charm text-base md:text-lg tracking-[0.12em] text-[#9d8048] mb-1">
              Cuenta
            </p>
            <p class="font-crimson text-base md:text-lg text-[#535636] font-semibold tracking-[0.06em]">
              [ PENDIENTE: Nº de cuenta ]
            </p>
          </div>

          <!-- DESTINATARIO -->
          <div class="text-center">
            <p class="font-charm text-base md:text-lg tracking-[0.12em] text-[#9d8048] mb-1">
              Destinatario
            </p>
            <p class="font-charm text-lg md:text-xl text-[#535636] leading-snug">
              [ PENDIENTE: titular de la cuenta ]
            </p>
          </div>

        </div>

        <!-- DECORACIÓN INFERIOR -->
        <div class="relative z-10 flex justify-center mt-8" id="decoracion-qr">
          <div class="flex gap-2">
            <div class="w-2 h-2 rounded-full bg-[#9d8048] opacity-60"></div>
            <div class="w-2 h-2 rounded-full bg-[#9d8048] opacity-80"></div>
            <div class="w-2 h-2 rounded-full bg-[#9d8048]"></div>
            <div class="w-2 h-2 rounded-full bg-[#9d8048] opacity-80"></div>
            <div class="w-2 h-2 rounded-full bg-[#9d8048] opacity-60"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  if (typeof window !== "undefined") {
    document.addEventListener("DOMContentLoaded", () => {
      console.log("🎁 Iniciando animación de Sugerencia de Regalos...");

      // 🎯 ESTADO INICIAL
      gsap.set("#hoja-qr-izq", { opacity: 0, x: -32 });
      gsap.set("#hoja-qr-der", { opacity: 0, x: 32 });
      gsap.set("#titulo-qr", { opacity: 0, scale: 0.94 });
      gsap.set("#icono-regalo", { opacity: 0, scale: 0.92, y: -16 });
      gsap.set("#flores-qr-izq", { opacity: 0, x: -22 });
      gsap.set("#flores-qr-der", { opacity: 0, x: 22 });
      gsap.set("#mensaje-qr", { opacity: 0, scale: 0.94 });
      gsap.set("#card-qr", { opacity: 0, scale: 0.94 });
      gsap.set("#qr-container", { opacity: 0, scale: 0.94 });
      gsap.set("#datos-qr", { opacity: 0, y: 16 });
      gsap.set("#decoracion-qr", { opacity: 0, scale: 0.94 });

      // ✨ ANIMACIÓN CON SCROLLTRIGGER - TODO SIMULTÁNEO
      ScrollTrigger.create({
        trigger: "#titulo-qr",
        start: "top 85%",
        end: "top 20%",
        onEnter: () => {
          gsap.to(
            "#titulo-qr, #mensaje-qr, #card-qr, #qr-container, #decoracion-qr",
            {
              opacity: 1,
              scale: 1,
              duration: 1.6,
              ease: "power2.out",
              stagger: 0.12,
            },
          );

          gsap.to("#datos-qr", {
            opacity: 1,
            y: 0,
            duration: 1.6,
            ease: "power2.out",
            delay: 0.55,
          });

          gsap.to("#icono-regalo", {
            opacity: 1,
            scale: 1,
            y: 0,
            duration: 1.6,
            ease: "power2.out",
            delay: 0.1,
          });

          gsap.to("#hoja-qr-izq, #hoja-qr-der", {
            opacity: 0.6,
            x: 0,
            duration: 1.6,
            ease: "power3.out",
          });

          gsap.to("#flores-qr-izq, #flores-qr-der", {
            opacity: 1,
            x: 0,
            duration: 1.6,
            ease: "power2.out",
            delay: 0.25,
            stagger: 0.12,
          });

          // 💫 ANIMACIONES CONTINUAS

          // Latido suave del icono de regalo
          gsap.to("#icono-regalo", {
            scale: 1.06,
            duration: 2.5,
            ease: "sine.inOut",
            yoyo: true,
            repeat: -1,
            delay: 1.2,
          });

          // Pulso en puntos decorativos
          gsap.to("#decoracion-qr > div > div", {
            scale: 1.3,
            opacity: 0.4,
            duration: 2,
            ease: "sine.inOut",
            yoyo: true,
            repeat: -1,
            stagger: 0.15,
            delay: 1.5,
          });
        },
        onLeaveBack: () => {
          gsap.set("#hoja-qr-izq", { opacity: 0, x: -32 });
          gsap.set("#hoja-qr-der", { opacity: 0, x: 32 });
          gsap.set("#titulo-qr", { opacity: 0, scale: 0.94 });
          gsap.set("#icono-regalo", { opacity: 0, scale: 0.92, y: -16 });
          gsap.set("#flores-qr-izq", { opacity: 0, x: -22 });
          gsap.set("#flores-qr-der", { opacity: 0, x: 22 });
          gsap.set("#mensaje-qr", { opacity: 0, scale: 0.94 });
          gsap.set("#card-qr", { opacity: 0, scale: 0.94 });
          gsap.set("#qr-container", { opacity: 0, scale: 0.94 });
          gsap.set("#datos-qr", { opacity: 0, y: 16 });
          gsap.set("#decoracion-qr", { opacity: 0, scale: 0.94 });
        },
      });

      console.log("🎁✨ ¡Componente Sugerencia de Regalos activado!");
    });
  }
</script>

<style>
  /* Icono de regalo pintado en dorado (misma técnica que en los demás) */
  .icono-regalo-dorado {
    background-color: #9d8048;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
    -webkit-mask-size: contain;
    mask-size: contain;
  }

  /* Transición suave para el card */
  #card-qr {
    transition: all 0.3s ease;
  }

  #card-qr:hover {
    box-shadow: 0 25px 60px rgba(157, 128, 72, 0.25);
    transform: translateY(-5px);
  }

  /* Efecto hover en el QR */
  #qr-container > div:first-child {
    transition: all 0.4s ease;
  }

  #qr-container:hover > div:first-child {
    transform: scale(1.05);
    box-shadow: 0 12px 30px rgba(157, 128, 72, 0.3);
  }

  /* Hojas con transición */
  #hoja-qr-izq,
  #hoja-qr-der {
    will-change: transform;
  }

  /* Puntos decorativos */
  #decoracion-qr > div > div {
    transition: all 0.3s ease;
  }
</style>
