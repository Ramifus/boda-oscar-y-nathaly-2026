---
// Despedida.astro
---
<section class="py-4 px-4 relative overflow-hidden">
  <div class="max-w-6xl mx-auto relative z-10">
    <div class="max-w-4xl mx-auto text-center">

      <!-- 🌸 FLORES SUPERIORES -->
      <!-- <div class="flex justify-center mb-10" id="flores-arriba-despedida">
        <img
          src="/imagenes/separador.png"
          alt="Flores decorativas"
          class="w-40 md:w-48 lg:w-56 h-auto object-contain opacity-90"
        />
      </div> -->

      <!-- CARD PRINCIPAL -->
      <div 
        class="relative backdrop-blur-sm bg-white/10 rounded-[2.5rem] border-2 border-[#9d8048]/20 p-10 md:p-12 lg:p-16" 
        id="card-despedida"
      >
        <!-- Brillo superior sutil -->
        <div class="absolute top-0 left-0 right-0 h-1/2 bg-gradient-to-b from-white/10 to-transparent rounded-t-[2.5rem] pointer-events-none"></div>

        <!-- Ornamentos decorativos en las esquinas -->
        <div class="absolute top-4 left-4 w-16 h-16">
          <div class="absolute top-0 left-0 w-full h-0.5 bg-gradient-to-r from-[#9d8048]/40 to-transparent"></div>
          <div class="absolute top-0 left-0 w-0.5 h-full bg-gradient-to-b from-[#9d8048]/40 to-transparent"></div>
        </div>
        <div class="absolute top-4 right-4 w-16 h-16">
          <div class="absolute top-0 right-0 w-full h-0.5 bg-gradient-to-l from-[#9d8048]/40 to-transparent"></div>
          <div class="absolute top-0 right-0 w-0.5 h-full bg-gradient-to-b from-[#9d8048]/40 to-transparent"></div>
        </div>
        <div class="absolute bottom-4 left-4 w-16 h-16">
          <div class="absolute bottom-0 left-0 w-full h-0.5 bg-gradient-to-r from-[#9d8048]/40 to-transparent"></div>
          <div class="absolute bottom-0 left-0 w-0.5 h-full bg-gradient-to-t from-[#9d8048]/40 to-transparent"></div>
        </div>
        <div class="absolute bottom-4 right-4 w-16 h-16">
          <div class="absolute bottom-0 right-0 w-full h-0.5 bg-gradient-to-l from-[#9d8048]/40 to-transparent"></div>
          <div class="absolute bottom-0 right-0 w-0.5 h-full bg-gradient-to-t from-[#9d8048]/40 to-transparent"></div>
        </div>

        <div class="relative z-10">
          <!-- TÍTULO -->
          <div id="titulo-despedida" class="mb-8">
            <h2 class="font-charm text-3xl md:text-3xl lg:text-3xl text-[#9d8048] font-bold mb-4">
              Querida Familia y Amigos
            </h2>
            <div class="flex items-center justify-center gap-3">
              <div class="w-16 h-[2px] bg-gradient-to-r from-transparent to-[#9d8048]"></div>
              <div class="w-2 h-2 rounded-full bg-[#9d8048]"></div>
              <div class="w-16 h-[2px] bg-gradient-to-l from-transparent to-[#9d8048]"></div>
            </div>
          </div>

          <!-- MENSAJE PRINCIPAL -->
          <div id="mensaje-despedida" class="space-y-6 mb-10">
            <p class="parrafo-animado font-charm text-xl md:text-2xl lg:text-3xl text-[#535636] leading-relaxed">
              Con gran alegría y gratitud a Dios, queremos compartir con ustedes uno de los momentos más importantes de nuestras vidas.
            </p>
            <p class="parrafo-animado font-charm text-xl md:text-2xl lg:text-3xl text-[#535636] leading-relaxed">
              Hoy, nuestros caminos se unen para comenzar una nueva historia juntos, y no podríamos imaginar este día sin la presencia de las personas que más queremos.
            </p>
            <p class="parrafo-animado font-charm text-xl md:text-2xl lg:text-3xl text-[#535636] leading-relaxed">
              ¡Los esperamos para compartir amor, alegría y muchas bendiciones en este día tan especial!
            </p>
          </div>

          <!-- LÍNEA DECORATIVA CON CORAZÓN -->
          <div class="flex items-center justify-center gap-4 my-10" id="linea-decorativa">
            <div class="w-20 h-[1px] bg-gradient-to-r from-transparent via-[#9d8048] to-[#9d8048]"></div>
            <div class="relative">
              <svg class="w-8 h-8 text-[#9d8048]" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
              </svg>
            </div>
            <div class="w-20 h-[1px] bg-gradient-to-l from-transparent via-[#9d8048] to-[#9d8048]"></div>
          </div>

          <!-- SECCIÓN CONFIRMAR ASISTENCIA -->
          <div id="seccion-confirmar" class="mt-10">
            <p class="font-charm text-2xl md:text-3xl lg:text-4xl text-[#9d8048] font-bold mb-8" id="texto-confirmar">
              Esperamos contar con tu presencia
            </p>
            <div class="flex flex-col sm:flex-row items-center justify-center gap-4 md:gap-6 mb-10" id="boton-confirmar">

              <!-- 💚 CONFIRMAR CON EL NOVIO -->
              <a
                href="https://wa.me/59165564369?text=Me%20complace%20confirmar%20mi%20asistencia%20a%20la%20boda%20de%20Oscar%20y%20Nathaly.%20Nos%20vemos%20el%20s%C3%A1bado%2026%20de%20septiembre.%20%C2%A1Estar%C3%A9%20sin%20falta!"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-3 rounded-full bg-[#535636] border border-[#9d8048]/60 shadow-md px-8 py-3 md:px-10 md:py-3.5 cursor-pointer transition-transform duration-300 hover:scale-105"
              >
                <svg
                  class="w-5 h-5 md:w-6 md:h-6 text-[#d9c69c] flex-shrink-0"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.87 9.87 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm5.8 14.13c-.25.69-1.46 1.35-2 1.39-.51.04-1.16.21-3.76-.79-3.16-1.22-5.16-4.45-5.32-4.66-.16-.21-1.27-1.69-1.27-3.22s.8-2.29 1.09-2.6c.28-.31.62-.39.82-.39.2 0 .41 0 .59.01.19.01.44-.7.84.64.41.72 1.39 2.4 1.51 2.57.12.17.2.38.04.59-.16.21-.24.34-.47.53-.24.19-.5.43-.72.72-.21.29-.13.55.04.79.17.24.71 1.17 1.5 1.89 1.02.92 1.86 1.21 2.14 1.35.28.14.44.12.61-.07.17-.19.72-.84.91-1.13.19-.29.38-.24.63-.14.25.09 1.6.75 1.87.89.28.14.46.21.53.32.07.12.07.67-.18 1.36z"/>
                </svg>
                <span class="font-charm text-xl md:text-2xl tracking-wide text-[#f7f3ea] whitespace-nowrap">
                  Confirmar con el novio
                </span>
              </a>

              <!-- 💚 CONFIRMAR CON LA NOVIA -->
              <a
                href="https://wa.me/59169751777?text=Me%20complace%20confirmar%20mi%20asistencia%20a%20la%20boda%20de%20Oscar%20y%20Nathaly.%20Nos%20vemos%20el%20s%C3%A1bado%2026%20de%20septiembre.%20%C2%A1Estar%C3%A9%20sin%20falta!"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-3 rounded-full bg-[#535636] border border-[#9d8048]/60 shadow-md px-8 py-3 md:px-10 md:py-3.5 cursor-pointer transition-transform duration-300 hover:scale-105"
              >
                <svg
                  class="w-5 h-5 md:w-6 md:h-6 text-[#d9c69c] flex-shrink-0"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.87 9.87 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm5.8 14.13c-.25.69-1.46 1.35-2 1.39-.51.04-1.16.21-3.76-.79-3.16-1.22-5.16-4.45-5.32-4.66-.16-.21-1.27-1.69-1.27-3.22s.8-2.29 1.09-2.6c.28-.31.62-.39.82-.39.2 0 .41 0 .59.01.19.01.44-.7.84.64.41.72 1.39 2.4 1.51 2.57.12.17.2.38.04.59-.16.21-.24.34-.47.53-.24.19-.5.43-.72.72-.21.29-.13.55.04.79.17.24.71 1.17 1.5 1.89 1.02.92 1.86 1.21 2.14 1.35.28.14.44.12.61-.07.17-.19.72-.84.91-1.13.19-.29.38-.24.63-.14.25.09 1.6.75 1.87.89.28.14.46.21.53.32.07.12.07.67-.18 1.36z"/>
                </svg>
                <span class="font-charm text-xl md:text-2xl tracking-wide text-[#f7f3ea] whitespace-nowrap">
                  Confirmar con la novia
                </span>
              </a>

            </div>
          </div>
        </div>
      </div>

      <!-- 🌸 FLORES INFERIORES -->
      <div class="flex justify-center mt-10" id="flores-abajo-despedida">
        <img
          src="/imagenes/separador.png"
          alt="Flores decorativas"
          class="w-40 md:w-48 lg:w-56 h-auto object-contain opacity-90 transform "
        />
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  if (typeof window !== 'undefined') {
    document.addEventListener('DOMContentLoaded', () => {
      console.log('💑 Iniciando sección de despedida de boda...');

      // 🎯 ESTADO INICIAL - Todos los elementos ocultos
      gsap.set('#flores-arriba-despedida', { opacity: 0, y: -22, scale: 0.94 });
      gsap.set('#card-despedida', { opacity: 0, y: 28, scale: 0.97 });
      gsap.set('#titulo-despedida', { opacity: 0, y: 22, filter: 'blur(5px)' });
      gsap.set('.parrafo-animado', { opacity: 0, y: 22, filter: 'blur(5px)' });
      gsap.set('#linea-decorativa', { opacity: 0, scale: 0.9 });
      gsap.set('#texto-confirmar', { opacity: 0, y: 16 });
      gsap.set('#boton-confirmar', { opacity: 0, scale: 0.94, y: 16 });
      gsap.set('#flores-abajo-despedida', { opacity: 0, y: 22, scale: 0.94 });

      // ✨ ANIMACIÓN SIMULTÁNEA - TODOS LOS ELEMENTOS AL MISMO TIEMPO
      ScrollTrigger.create({
        trigger: '#flores-arriba-despedida',
        start: 'top 85%',
        end: 'top 20%',
        onEnter: () => {
          const tl = gsap.timeline();

          // TODAS LAS ANIMACIONES INICIAN AL MISMO TIEMPO
          tl.to('#flores-arriba-despedida', {
            opacity: 0.9,
            y: 0,
            scale: 1,
            duration: 1.4,
            ease: 'power2.out',
          }, 0)

          .to('#card-despedida', {
            opacity: 1,
            y: 0,
            scale: 1,
            duration: 1.4,
            ease: 'power3.out',
          }, 0)

          .to('#titulo-despedida', {
            opacity: 1,
            y: 0,
            filter: 'blur(0px)',
            duration: 1.1,
            ease: 'power2.out',
          }, 0)

          .to('.parrafo-animado', {
            opacity: 1,
            y: 0,
            filter: 'blur(0px)',
            duration: 1.1,
            stagger: 0.15,
            ease: 'power2.out',
          }, 0)

          .to('#linea-decorativa', {
            opacity: 1,
            scale: 1,
            duration: 0.85,
            ease: 'power2.out',
          }, 0)

          .to('#texto-confirmar', {
            opacity: 1,
            y: 0,
            duration: 0.95,
            ease: 'power2.out',
          }, 0)

          .to('#boton-confirmar', {
            opacity: 1,
            scale: 1,
            y: 0,
            duration: 1.1,
            ease: 'power2.out',
          }, 0)

          .to('#flores-abajo-despedida', {
            opacity: 0.9,
            y: 0,
            scale: 1,
            duration: 1.4,
            ease: 'power2.out',
          }, 0);

          // 🌸 ANIMACIONES CONTINUAS (loop infinito)
          
          // Corazón latiendo
          gsap.to('#linea-decorativa svg', {
            scale: 1.3,
            duration: 1.5,
            ease: 'sine.inOut',
            yoyo: true,
            repeat: -1,
            delay: 0.5,
          });

          // Botón pulsando suavemente
          gsap.to('#boton-confirmar a', {
            scale: 1.05,
            y: -5,
            duration: 2.5,
            ease: 'sine.inOut',
            yoyo: true,
            repeat: -1,
            delay: 0.8,
          });

          // Texto confirmar con brillo sutil
          gsap.to('#texto-confirmar', {
            textShadow: '0 0 15px rgba(157, 128, 72, 0.5)',
            duration: 2.5,
            ease: 'sine.inOut',
            yoyo: true,
            repeat: -1,
            delay: 1,
          });
        },
        
        onLeaveBack: () => {
          // Resetear todo cuando se sale por arriba
          gsap.set('#flores-arriba-despedida', { opacity: 0, y: -22, scale: 0.94 });
          gsap.set('#card-despedida', { opacity: 0, y: 28, scale: 0.97 });
          gsap.set('#titulo-despedida', { opacity: 0, y: 22, filter: 'blur(5px)' });
          gsap.set('.parrafo-animado', { opacity: 0, y: 22, filter: 'blur(5px)' });
          gsap.set('#linea-decorativa', { opacity: 0, scale: 0.9 });
          gsap.set('#texto-confirmar', { opacity: 0, y: 16 });
          gsap.set('#boton-confirmar', { opacity: 0, scale: 0.94, y: 16 });
          gsap.set('#flores-abajo-despedida', { opacity: 0, y: 22, scale: 0.94 });
        },
      });

      console.log('💑✨ ¡Sección de despedida activada con éxito!');
    });
  }
</script>

<style>
  #card-despedida {
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  #card-despedida:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 40px rgba(157, 128, 72, 0.2);
  }

  #mensaje-despedida span {
    transition: all 0.3s ease;
    display: inline-block;
  }

  #mensaje-despedida span:hover {
    color: #a68652;
    transform: scale(1.05);
    text-shadow: 0 2px 10px rgba(157, 128, 72, 0.4);
  }
</style>